# GEO Web 服务环境变量示例（复制为 .env 或在部署平台注入，切勿提交真实密钥）

# ---- 数据目录（指向持久卷；多进程/容器部署务必外挂）----
GEO_DATA_DIR=/var/lib/geo/data

# ---- JWT / 会话（务必使用高熵随机值；可用 `python -c "import secrets;print(secrets.token_urlsafe(48))"` 生成）----
GEO_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
GEO_ACCESS_MIN=15            # access token 有效期（分钟）
GEO_REFRESH_DAYS=7           # refresh token 有效期（天）

# ---- 服务 ----
PORT=8000
HOST=0.0.0.0
GEO_BASE_URL=https://geo.example.com     # 对外基础 URL（用于 OAuth 回调拼接、产物链接）
GEO_CORS_ORIGINS=https://geo.example.com   # 逗号分隔的允许来源；* 表示全部（不推荐生产）
GEO_JOB_WORKERS=2                        # 单进程后台作业线程数

# ---- 企业微信 OAuth（留空则自动回落测试模式，无需凭据即可联调）----
# GEO_WEBCOM_CORPID=wwxxxxxxxx
# GEO_WEBCOM_CORPSECRET=xxxxxxxx
# GEO_WEBCOM_AGENTID=xxxxxx

# ---- 反向代理（如经 nginx/cloudflared，启用下方以便正确获取客户端 IP / 协议）----
# PROXY_HEADERS=1
